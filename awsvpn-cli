# profile
# --------------------------------------------------------------------------


class Profile:
    def __init__(self, path: Path, name: str | None):
        self.path = path
        self.text = path.read_text()
        self.name = name or re.sub(r"[^A-Za-z0-9_.-]", "-", path.stem)
        # Directive lines outside inline <blocks>, with the blocks kept apart.
        self.directives: list[list[str]] = []
        self.blocks: dict[str, str] = {}
        block = None
        buf: list[str] = []
        for raw in self.text.splitlines():
            line = raw.strip()
            m = re.fullmatch(r"<(/?)([a-z0-9-]+)>", line)
            if m and not m.group(1):
                block, buf = m.group(2), []
                continue
            if m and m.group(1):
                self.blocks[block] = "\n".join(buf).strip()
                block = None
                continue
            if block is not None:
                buf.append(raw)
            elif line and not line.startswith(("#", ";")):
                self.directives.append(line.split())

        def first(key: str) -> list[str] | None:
            return next((d for d in self.directives if d[0] == key), None)

        if not first("auth-federate"):
            if self.text.startswith(GENERATED_MARK):
                source = self.text.splitlines()[0][len(GENERATED_MARK):]
                die(f"{path} is a config rendered by awsvpn-cli, not a profile:\n"
                    f"       use --profile {source}")
            die(f"{path} has no auth-federate: not a SAML (federated) Client VPN profile")
        remote = first("remote") or die("no remote in profile")
        self.host = remote[1]
        self.port = int(remote[2]) if len(remote) > 2 else 1194
        proto = (remote[3] if len(remote) > 3 else None) or (first("proto") or [None, "udp"])[1]
        self.proto = "tcp" if proto.startswith("tcp") else "udp"
        self.random_hostname = bool(first("remote-random-hostname"))
        self.ca = self.blocks.get("ca") or die("no <ca> in profile")
        v = first("verify-x509-name")
        self.verify_name = v[1] if v else None
        m = re.search(r"\.clientvpn\.([a-z0-9-]+)\.amazonaws\.com$", self.host)
        self.region = m.group(1) if m else None

    def resolve(self) -> str:
        """One IPv4 address of the gateway, for both legs.

        remote-random-hostname prepends a random label, which the Client VPN
        wildcard record answers, so each lookup bypasses resolver caches.
        """
        host = f"{secrets.token_hex(12)}.{self.host}" if self.random_hostname else self.host
        try:
            infos = socket.getaddrinfo(host, self.port, socket.AF_INET, socket.SOCK_STREAM)
        except socket.gaierror as exc:
            die(f"cannot resolve {self.host}: {exc}")
        return infos[0][4][0]

    def dns_domains(self, extra: list[str]) -> list[str]:
        # The endpoint pushes a DNS server but no domain. AWS private endpoints
        # keep their public names (the EKS API is <id>.<x>.<region>.eks.
        # amazonaws.com), so only the VPC resolver knows the private answer.
        base = (
            [f"{self.region}.eks.amazonaws.com", f"{self.region}.rds.amazonaws.com",
             f"{self.region}.compute.internal"]
            if self.region
            else []
        )
        out: list[str] = []
        for d in base + extra:
            d = d.strip().lstrip(".")
            if d and d not in out:
                out.append(d)
        return out

    def describe(self) -> str:
        return (
            f"    profile   : {self.path}\n"
            f"    name      : {self.name}\n"
            f"    gateway   : {self.host}:{self.port} {self.proto}\n"
            f"    cert CN   : {self.verify_name or '(not pinned by the profile)'}"
        )


# --------------------------------------------------------------------------
# leg 1: a minimal OpenVPN control channel, enough to read the SAML challenge
# --------------------------------------------------------------------------

P_CONTROL_V1 = 4
P_ACK_V1 = 5
P_CONTROL_HARD_RESET_CLIENT_V2 = 7
P_CONTROL_HARD_RESET_SERVER_V2 = 8

# id-kp-serverAuth (1.3.6.1.5.5.7.3.1), DER-encoded. The stdlib exposes no
# EKU, so remote-cert-tls is checked as the presence of this OID in the cert.
SERVER_AUTH_OID = bytes.fromhex("06082b06010505070301")

TLS_CHUNK = 1100  # TLS bytes per control packet, below any sane path MTU
RETRANSMIT_AFTER = 2.0


class GatewayCertError(Exception):
    """The gateway's certificate chains to the CA but fails the profile's pins."""


class Challenge:
    def __init__(self, raw: str):
        # AUTH_FAILED,CRV1:<flags>:<state id>:<base64 username>:<text>
        body = raw.split(",", 1)[1] if "," in raw else ""
        parts = body.split(":", 4)
        if len(parts) != 5 or parts[0] != "CRV1":
            raise ValueError(raw[:200])
        self.flags, self.sid, self.user, self.url = parts[1], parts[2], parts[3], parts[4]
        if not self.url.startswith("https://"):
            raise ValueError("challenge text is not a URL")


class ControlChannel:
    """Just enough OpenVPN to log in and read the reply. No data channel.

    Wire format, without tls-auth/tls-crypt (AWS Client VPN uses neither):
      opcode<<3|key_id, session_id[8], n_acks, acked ids[4*n],
      peer session_id[8] if n_acks, packet_id[4] unless P_ACK_V1, payload.
    Over TCP each packet is prefixed with its 16-bit length.
    """

    def __init__(self, ip: str, port: int, proto: str, ca_pem: str, verify_name: str | None,
                 timeout: float = 30.0):
        self.proto = proto
        self.deadline = time.monotonic() + timeout
        kind = socket.SOCK_STREAM if proto == "tcp" else socket.SOCK_DGRAM
        self.sock = socket.socket(socket.AF_INET, kind)
        self.sock.settimeout(timeout)
        self.sock.connect((ip, port))
        self.sock.setblocking(False)
        self.tcp_buf = b""

        self.sid = secrets.token_bytes(8)
        self.peer_sid: bytes | None = None
        self.next_id = 0
        self.unacked: dict[int, list] = {}  # id -> [packet, last sent]
        self.to_ack: list[int] = []
        self.recv_next = 0
        self.recv_early: dict[int, tuple[int, bytes]] = {}

        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.check_hostname = False  # OpenVPN pins the CN, not a host name
        ctx.verify_mode = ssl.CERT_REQUIRED
        ctx.load_verify_locations(cadata=ca_pem)
        self.verify_name = verify_name
        self.tls_in = ssl.MemoryBIO()
        self.tls_out = ssl.MemoryBIO()
        self.tls = ctx.wrap_bio(self.tls_in, self.tls_out, server_side=False)

    # -- packets -----------------------------------------------------------

    def _header(self, op: int) -> bytes:
        acks, self.to_ack = self.to_ack[:8], self.to_ack[8:]
        h = bytes([op << 3]) + self.sid + bytes([len(acks)])
        h += b"".join(struct.pack(">I", a) for a in acks)
        if acks:
            h += self.peer_sid
        return h

    def _wire(self, pkt: bytes) -> None:
        data = struct.pack(">H", len(pkt)) + pkt if self.proto == "tcp" else pkt
        try:
            self.sock.sendall(data) if self.proto == "tcp" else self.sock.send(data)
        except BlockingIOError:
            pass  # UDP: dropped like any lost datagram, retransmitted later

    def _send_reliable(self, op: int, payload: bytes = b"") -> None:
        pkt = self._header(op) + struct.pack(">I", self.next_id) + payload
        self.unacked[self.next_id] = [pkt, time.monotonic()]
        self.next_id += 1
        self._wire(pkt)

    def _recv_packets(self) -> list[bytes]:
        out = []
        try:
            while True:
                if self.proto == "udp":
                    out.append(self.sock.recv(65535))
                    continue
                chunk = self.sock.recv(65535)
                if not chunk:
                    raise ConnectionError("gateway closed the TCP connection")
                self.tcp_buf += chunk
                while len(self.tcp_buf) >= 2:
                    n = struct.unpack(">H", self.tcp_buf[:2])[0]
                    if len(self.tcp_buf) < 2 + n:
                        break
                    out.append(self.tcp_buf[2 : 2 + n])
                    self.tcp_buf = self.tcp_buf[2 + n :]
        except (BlockingIOError, InterruptedError):
            pass
        return out

    def _handle(self, pkt: bytes) -> None:
        if len(pkt) < 10:
            return
        op, psid, n = pkt[0] >> 3, pkt[1:9], pkt[9]
        if op not in (P_CONTROL_V1, P_ACK_V1, P_CONTROL_HARD_RESET_SERVER_V2):
            return  # data or soft-reset packets: not ours to handle
        off = 10
        for i in range(n):
            self.unacked.pop(struct.unpack(">I", pkt[off + 4 * i : off + 4 * i + 4])[0], None)
        off += 4 * n
        if n:
            if pkt[off : off + 8] != self.sid:
                return
            off += 8
        if self.peer_sid is None:
            self.peer_sid = psid
        elif psid != self.peer_sid:
            return
        if op == P_ACK_V1:
            return
        pid = struct.unpack(">I", pkt[off : off + 4])[0]
        self.to_ack.append(pid)
        if pid >= self.recv_next:
            self.recv_early[pid] = (op, pkt[off + 4 :])
        while self.recv_next in self.recv_early:
            op_, payload = self.recv_early.pop(self.recv_next)
            self.recv_next += 1
            if op_ == P_CONTROL_V1:
                self.tls_in.write(payload)

    def _pump(self) -> None:
        """Flush TLS output, (re)send, wait briefly, read and ACK."""
        if time.monotonic() > self.deadline:
            raise TimeoutError("no answer from the gateway in time")
        while self.peer_sid is not None:
            data = self.tls_out.read(TLS_CHUNK)
            if not data:
                break
            self._send_reliable(P_CONTROL_V1, data)
        now = time.monotonic()
        if self.proto == "udp":
            for entry in self.unacked.values():
                if now - entry[1] > RETRANSMIT_AFTER:
                    self._wire(entry[0])
                    entry[1] = now
        r, _, _ = select.select([self.sock], [], [], 0.25)
        if r:
            for pkt in self._recv_packets():
                self._handle(pkt)
        if self.to_ack and self.peer_sid is not None:
            self._wire(self._header(P_ACK_V1))

    # -- protocol ----------------------------------------------------------

    def _check_peer(self) -> str:
        der = self.tls.getpeercert(binary_form=True) or b""
        cert = self.tls.getpeercert() or {}
        cn = next((v for rdn in cert.get("subject", ()) for k, v in rdn if k == "commonName"), "")
        if self.verify_name and cn != self.verify_name:
            raise GatewayCertError(f"gateway cert CN is {cn!r}, the profile pins {self.verify_name!r}")
        if SERVER_AUTH_OID not in der:
            raise GatewayCertError("gateway cert has no serverAuth extended key usage")
        return cn

    def challenge(self, username: str, password: str) -> tuple[Challenge, str]:
        self._send_reliable(P_CONTROL_HARD_RESET_CLIENT_V2)
        while self.peer_sid is None or self.recv_next == 0:
            self._pump()
        while True:
            try:
                self.tls.do_handshake()
                break
            except ssl.SSLWantReadError:
                self._pump()
        cn = self._check_peer()

        def s(v: str) -> bytes:
            b = v.encode() + b"\0"
            return struct.pack(">H", len(b)) + b

        options = (
            f"V4,dev-type tun,link-mtu 1521,tun-mtu 1500,"
            f"proto {'TCPv4_CLIENT' if self.proto == 'tcp' else 'UDPv4'},"
            "cipher AES-256-GCM,auth [null-digest],keysize 256,key-method 2,tls-client"
        )
        peer_info = (
            f"IV_PLAT={'android' if IS_TERMUX else 'linux'}\nIV_NCP=2\nIV_TCPNL=1\nIV_PROTO=2\n"
            "IV_CIPHERS=AES-256-GCM:AES-128-GCM\nIV_GUI_VER=awsvpn-cli\n"
        )
        # key method 2: literal 0, method 2, pre-master and two randoms
        # (never used: this session never reaches a data channel), options,
        # username, password, peer info.
        km2 = (
            b"\0\0\0\0\x02" + secrets.token_bytes(48 + 32 + 32)
            + s(options) + s(username) + s(password) + s(peer_info)
        )
        self.tls.write(km2)

        plain = b""
        pushed = False
        while True:
            try:
                plain += self.tls.read(16384)
            except ssl.SSLWantReadError:
                self._pump()
            except ssl.SSLZeroReturnError:
                break
            # The server's own key-method-2 blob comes first; after it, control
            # messages are NUL-terminated text.
            if not pushed and len(plain) >= 5 + 64:
                self.tls.write(b"PUSH_REQUEST\0")
                pushed = True
            m = re.search(rb"(AUTH_FAILED[^\0]*)\0", plain)
            if m:
                return Challenge(m.group(1).decode(errors="replace")), cn
            if re.search(rb"PUSH_REPLY", plain):
                raise RuntimeError("the gateway accepted the leg-1 login: not a SAML endpoint?")
        raise ConnectionError("gateway closed the TLS session without a challenge")

    def close(self) -> None:
        try:
            self.sock.close()
        except OSError:
            pass


def saml_challenge(p: Profile, ip: str) -> tuple[Challenge, str]:
    ch = ControlChannel(ip, p.port, p.proto, p.ca, p.verify_name)
    try:
        return ch.challenge("N/A", f"ACS::{ACS_PORT}")
    except (OSError, ssl.SSLError, GatewayCertError, TimeoutError, ValueError, RuntimeError) as exc:
        die(f"leg 1 against {ip}:{p.port}/{p.proto} failed: {exc}")
    finally:
        ch.close()


# --------------------------------------------------------------------------
# sign-in: catch the SAML response Entra posts to 127.0.0.1:35001
# --------------------------------------------------------------------------


class _AcsCatcher(http.server.BaseHTTPRequestHandler):
    result: dict = {}

    def do_POST(self):  # noqa: N802
        n = int(self.headers.get("Content-Length") or 0)
        form = urllib.parse.parse_qs(self.rfile.read(min(n, 1 << 20)).decode(errors="replace"))
        _AcsCatcher.result = {k: v[0] for k, v in form.items()}
        ok = "SAMLResponse" in _AcsCatcher.result
        body = (
            "<html><body style='font-family:system-ui;padding:3em'>"
            f"<h2>{'Signed in.' if ok else 'Sign-in failed.'}</h2>"
            + ("<p>Switch back to Termux and press Enter.</p>" if IS_TERMUX
               else "<p>Close this tab and return to the terminal.</p>")
            + "</body></html>"
        ).encode()
        self.send_response(200 if ok else 400)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):  # noqa: N802
        self.send_response(404)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def log_message(self, *_a):
        pass


def sign_in(p: Profile, ip: str) -> str:
    """Both legs of the sign-in; returns the single-use leg-2 password."""
    try:
        srv = http.server.HTTPServer(("127.0.0.1", ACS_PORT), _AcsCatcher)
    except OSError as exc:
        die(
            f"cannot bind 127.0.0.1:{ACS_PORT} ({exc}).\n"
            "       The AWS VPN Client uses the same port: quit it and retry."
        )
    try:
        log(f"leg 1: asking {ip}:{p.port}/{p.proto} for a sign-in challenge")
        chal, cn = saml_challenge(p, ip)
        log(f"gateway cert {cn} verified; challenge received")
        _AcsCatcher.result = {}
        srv.timeout = 1
        log("opening a browser for sign-in…")
        print(f"    if it does not open, visit:\n    {chal.url}\n", file=sys.stderr)
        open_browser(chal.url)
        end = time.monotonic() + SIGN_IN_TIMEOUT
        # Loop: a stray GET (favicon, a preview) must not end the wait.
        while not _AcsCatcher.result and time.monotonic() < end:
            srv.handle_request()
    finally:
        srv.server_close()
    res = _AcsCatcher.result
    if not res:
        die(f"no sign-in response within {SIGN_IN_TIMEOUT} s")
    saml = res.get("SAMLResponse")
    if not saml:
        die(f"the sign-in redirect carried no SAMLResponse (fields: {', '.join(res) or 'none'})")
    log("signed in")
    return f"CRV1::{chal.sid}::{saml}"


# --------------------------------------------------------------------------
# OpenVPN config for leg 2
# --------------------------------------------------------------------------


def ovpn_config(p: Profile, ip: str, domains: list[str], inline_password: str | None = None) -> str:
    """The leg-2 config. With inline_password (Android), the credentials ride
    in an <auth-user-pass> block, which the app imports without a text field."""
    kept = [
        " ".join(d) for d in p.directives
        if d[0] not in DROP_DIRECTIVES and d[0] != "auth-user-pass"
    ]
    if not any(k.startswith("data-ciphers ") for k in kept):
        kept.append(f"data-ciphers {DATA_CIPHERS}")
    blocks = {k: v for k, v in p.blocks.items() if k != "auth-user-pass"}
    if inline_password is None:
        kept.append("auth-user-pass")
    else:
        blocks["auth-user-pass"] = f"N/A\n{inline_password}"
    dns = "\n".join(f"dhcp-option DOMAIN {d}" for d in domains) or "# no routing domains"
    rendered = "\n\n".join(f"<{k}>\n{v}\n</{k}>" for k, v in blocks.items())
    return f"""{GENERATED_MARK}{p.path}
# Pinned to one gateway IP: the SAML state id is valid only on the node that
# issued it. Rendered afresh on every `up`.
remote {ip} {p.port} {p.proto}
{chr(10).join(kept)}

# Split DNS: the endpoint pushes a resolver but no domains. These names go to
# the VPC resolver; everything else keeps your normal DNS.
{dns}

{rendered}
"""


# --------------------------------------------------------------------------
# openvpn3 driver (Linux)
# --------------------------------------------------------------------------


def o3(*args: str, **kw) -> subprocess.CompletedProcess:
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    return subprocess.run(["openvpn3", *args], **kw)


ANDROID_HINT = (
    "on Android the tunnel is run by OpenVPN for Android, not by this tool:\n"
    "           use `awsvpn-cli up` to sign in and hand the app a profile, and\n"
    "           disconnect in the app"
)


def require_openvpn3() -> None:
    if IS_TERMUX:
        die(ANDROID_HINT)
    if platform.system() != "Linux":
        die(f"openvpn3-linux is Linux only; this is {platform.system()}")
    if not shutil.which("openvpn3"):
        die(
            "openvpn3 not found; it is required, not optional.\n"
            "       https://openvpn.net/as-docs/openvpn3-linux.html"
        )


def session_for(name: str) -> dict | None:
    for block in o3("sessions-list").stdout.split("---"):
        if re.search(rf"Config name:\s+{re.escape(name)}\s*$", block, re.M):
            # Some lines carry two pairs: "Owner: me      Device: tun1".
            return {
                k: v.strip()
                for line in block.splitlines()
                for k, v in re.findall(
                    r"([A-Z][A-Za-z ]*?):\s+(.*?)(?=\s{2,}[A-Z][A-Za-z ]*:\s|$)", line
                )
            }
    return None


def render(p: Profile, ip: str, domains: list[str], inline_password: str | None = None) -> Path:
    path = RENDER_DIR / f"{p.name}.ovpn"
    if path.resolve() == p.path.resolve():
        die(f"refusing to render over the profile itself: {p.path}")
    write_private(path, ovpn_config(p, ip, domains, inline_password))
    return path


def cmd_check(p: Profile) -> int:
    ip = p.resolve()
    log(f"leg 1 against {ip}:{p.port}/{p.proto}")
    chal, cn = saml_challenge(p, ip)
    print(p.describe())
    print(f"    address   : {ip}")
    print(f"    cert      : {cn} (CA and serverAuth verified)")
    print(f"    challenge : CRV1 flags {chal.flags}, sign-in at {urllib.parse.urlparse(chal.url).netloc}")
    return 0


def cmd_up(p: Profile, domains: list[str]) -> int:
    if IS_TERMUX:
        return cmd_up_android(p, domains)
    require_openvpn3()
    if session_for(p.name):
        log(f"{p.name} is already connected")
        return cmd_status(p)
    ip = p.resolve()
    password = sign_in(p, ip)
    path = render(p, ip, domains)

    o3("config-remove", "--config", p.name, "--force")
    r = o3("config-import", "--config", str(path), "--name", p.name)
    if r.returncode != 0:
        die(f"config-import failed: {(r.stdout + r.stderr).strip()[:400]}")
    # Split DNS instead of hijacking every query.
    o3("config-manage", "--config", p.name, "--dns-scope", "tunnel")

    log(f"leg 2: connecting to {ip}:{p.port}/{p.proto}")
    r = subprocess.run(
        ["openvpn3", "session-start", "--config", p.name],
        input=f"N/A\n{password}\n",
        capture_output=True,
        text=True,
        timeout=120,
    )
    out = (r.stdout or "") + (r.stderr or "")
    if "Connected to" not in out:
        log("session-start did not report a connection:")
        for line in out.strip().splitlines()[-12:]:
            print(f"    {line}", file=sys.stderr)
        return 1
    return cmd_status(p)


def cmd_down(p: Profile) -> int:
    require_openvpn3()
    if not session_for(p.name):
        log(f"{p.name} is not connected")
        return 0
    o3("session-manage", "--config", p.name, "--disconnect")
    if session_for(p.name):
        die(f"could not disconnect {p.name}")
    log(f"{p.name} disconnected")
    return 0


def cmd_status(p: Profile) -> int:
    print(f"==> {p.name}")
    print(p.describe())
    if IS_TERMUX:
        print("    tunnel    : run by OpenVPN for Android (not visible from Termux)")
        return 0
    sess = session_for(p.name) if shutil.which("openvpn3") else None
    if not sess:
        print("    tunnel    : DOWN")
        return 1
    dev = sess.get("Device") or "?"
    print(f"    tunnel    : UP, {sess.get('Status', 'connected')}  ({sess.get('Connected to', '?')})")
    addr = subprocess.run(["ip", "-brief", "addr", "show", dev], capture_output=True, text=True)
    routes = subprocess.run(["ip", "route", "show", "dev", dev], capture_output=True, text=True)
    print(f"    interface : {addr.stdout.strip() or dev}")
    print(f"    routes    : {len([x for x in routes.stdout.splitlines() if x.strip()])} via {dev}")
    if "reconnect" in sess.get("Status", "").lower():
        print("    note      : reconnecting replays a single-use password and cannot succeed;\n"
              "                run `awsvpn-cli down` and `up` again")
    return 0


def cmd_logs(p: Profile) -> int:
    require_openvpn3()
    if not session_for(p.name):
        die(f"{p.name} is not connected; openvpn3 logs are attached to a session")
    return subprocess.run(["openvpn3", "log", "--config", p.name]).returncode


