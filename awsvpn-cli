CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "awsvpn-cli"
# Rendered configs live apart from CONFIG_DIR itself, where users keep their
# profiles: rendering <name>.ovpn next to them would overwrite the source.
RENDER_DIR = CONFIG_DIR / "rendered"
GENERATED_MARK = "# Generated by awsvpn-cli from "

# The AWS VPN Client listens here for the SAML response, and the Client VPN
# service tells Entra to post it here: the port comes from the leg-1 password.
ACS_PORT = 35001
SIGN_IN_TIMEOUT = 300

IS_TERMUX = "com.termux" in os.environ.get("PREFIX", "")
# The Android profile carries the single-use password; the app copies it on
# import, so the file is removed shortly after it is handed over.
ANDROID_PROFILE_SECONDS = 120
# OpenVPN for Android's import keeps `cipher` only in its compatibility modes;
# `data-ciphers` always survives, so the rendered profile declares it.
DATA_CIPHERS = "AES-256-GCM:AES-128-GCM"

# AWS profile directives that openvpn3 and OpenVPN for Android do not know or
# that this tool replaces: the remote is pinned to one IP (see module doc).
DROP_DIRECTIVES = {
    "remote",
    "remote-random-hostname",
    "resolv-retry",
    "auth-federate",
    "auth-retry",
    "auth-nocache",
    "proto",
}


def log(msg: str) -> None:
    print(f"==> {msg}", file=sys.stderr)


def die(msg: str, code: int = 1):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def open_browser(url: str) -> None:
    # Python's webbrowser module finds no browser on Termux; termux-open-url
    # hands the URL to Android, which opens the default browser.
    if IS_TERMUX and shutil.which("termux-open-url"):
        subprocess.run(["termux-open-url", url], check=False)
    else:
        webbrowser.open(url)


def write_private(path: Path, data: str) -> None:
    """Create 0600 *before* the content lands in the file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(data)


