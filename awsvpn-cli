# Android (Termux): OpenVPN for Android runs the tunnel
# --------------------------------------------------------------------------


def _remove_later(path: str, seconds: str) -> int:
    time.sleep(int(seconds))
    Path(path).unlink(missing_ok=True)
    return 0


def remove_later(path: Path, seconds: int) -> None:
    """Delete `path` after `seconds` from a detached copy of this script, so
    the shell returns at once while the app still has time to read the file."""
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_remove-later", str(path), str(seconds)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def cmd_password(p: Profile) -> int:
    """Sign in and print the single-use leg-2 password, for another client."""
    print(sign_in(p, p.resolve()))
    return 0


def cmd_up_android(p: Profile, domains: list[str]) -> int:
    """Sign in, render a profile with the single-use password inline, and open
    it in the app that imports profiles.

    This is a VIEW ("open with") intent with a chooser: the OpenVPN apps
    register for opening .ovpn files but not for receiving shares. termux-open
    serves the file through Termux's own content provider, so it is never
    copied to shared storage, and the file is deleted soon after.
    """
    if not shutil.which("termux-open"):
        die("Android mode needs termux-open: pkg install termux-tools")
    ip = p.resolve()
    password = sign_in(p, ip)
    path = render(p, ip, domains, inline_password=password)
    # Android refuses to start an activity from an app in the background, and
    # after the sign-in the browser is in front: termux-open would return 0
    # and show nothing. Wait until the user is back in Termux.
    if sys.stdin.isatty():
        try:
            input("==> signed in. Back in Termux? Press Enter to open the profile in the app ")
        except EOFError:
            pass
    r = subprocess.run(
        ["termux-open", "--chooser", "--content-type", "application/x-openvpn-profile", str(path)]
    )
    if r.returncode != 0:
        path.unlink(missing_ok=True)
        die("termux-open failed")
    remove_later(path, ANDROID_PROFILE_SECONDS)
    # Plain lines, no "==>" prefix: these are instructions, not progress.
    print(
        f"\nPick OpenVPN for Android and import with the dialog defaults, then tap\n"
        f"the new {p.name} profile to connect, within a few minutes of signing in.\n"
        "\n"
        "  - Do not open the profile's editor, and cancel any password dialog:\n"
        "    both cut the password to 5000 characters and the login fails.\n"
        "  - The password works once. Next time, run `awsvpn-cli up` again and\n"
        "    delete the previous profile in the app.\n"
        "  - First time only: Settings > check \"OpenVPN 3 Core\".\n",
        file=sys.stderr,
    )
    return 0


# --------------------------------------------------------------------------


def resolve_profile(arg: str | None) -> Path:
    """Profile: --profile, else $AWSVPN_PROFILE, else the default location."""
    for cand in (arg, os.environ.get("AWSVPN_PROFILE"), CONFIG_DIR / "profile.ovpn"):
        if cand and Path(cand).expanduser().is_file():
            return Path(cand).expanduser().resolve()
    if arg:
        die(f"no such file: {arg}")
    die(
        "no profile. Export the endpoint's client configuration:\n"
        "           aws ec2 export-client-vpn-client-configuration \\\n"
        "             --client-vpn-endpoint-id cvpn-endpoint-... --output text > vpn.ovpn\n"
        "       then: awsvpn-cli up --profile vpn.ovpn\n"
        f"       or place it at {CONFIG_DIR / 'profile.ovpn'}, or set AWSVPN_PROFILE."
    )


def main() -> int:
    if sys.argv[1:2] == ["_remove-later"]:
        return _remove_later(*sys.argv[2:4])
    ap = argparse.ArgumentParser(
        prog="awsvpn-cli",
        description="Headless AWS Client VPN client for SAML (Entra ID) endpoints, via openvpn3.",
    )
    ap.add_argument(
        "command",
        choices=["check", "gen", "up", "down", "status", "logs", "password"],
    )
    ap.add_argument("--profile", help="path to the Client VPN .ovpn")
    ap.add_argument("--name", help="connection name (default: the profile's file name)")
    ap.add_argument(
        "--dns-domain", action="append", default=[], metavar="DOMAIN",
        help="extra domain to resolve through the VPC resolver (repeatable)",
    )
    args = ap.parse_args()

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)
    p = Profile(resolve_profile(args.profile), args.name)
    extra = args.dns_domain + os.environ.get("AWSVPN_DNS_DOMAINS", "").replace(",", " ").split()
    domains = p.dns_domains(extra)

    if args.command == "check":
        return cmd_check(p)
    if args.command == "gen":
        path = render(p, p.resolve(), domains)
        log(f"wrote {path}")
        return 0
    if args.command == "up":
        return cmd_up(p, domains)
    if args.command == "down":
        return cmd_down(p)
    if args.command == "status":
        return cmd_status(p)
    if args.command == "logs":
        return cmd_logs(p)
    if args.command == "password":
        return cmd_password(p)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
